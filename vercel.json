{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/report",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://get-an-expert-chat-production.up.railway.app/mcp"
    },
    {
      "source": "/classic",
      "destination": "/classic/index.html"
    },
    {
      "source": "/services/ugc-ads",
      "destination": "/services/ugc.html"
    },
    {
      "source": "/services/linkedin",
      "destination": "/services/linkedin.html"
    },
    {
      "source": "/services/voice-outbound",
      "destination": "/services/voice.html"
    },
    {
      "source": "/services/video-editing",
      "destination": "/services/video-editing.html"
    },
    {
      "source": "/services/explainer-videos",
      "destination": "/services/explainer.html"
    },
    {
      "source": "/services/ratemywipe",
      "destination": "/services/ratemywipe.html"
    }
  ],
  "headers": [
    {
      "source": "/mcp",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
