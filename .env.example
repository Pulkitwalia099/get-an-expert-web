# Powers the intake questions (claude-opus-4-8). Without it the chat runs a scripted demo flow.
ANTHROPIC_API_KEY=

# Live profile search across Upwork, Fiverr and the open web (serpapi.com).
# Without it three demo profiles are returned.
SERPAPI_KEY=

# Second retrieval engine, optional. Neural search plus page text in the same
# call. Without it the search runs on SerpAPI alone, exactly as it does today.
EXA_API_KEY=

# Optional. Each brief, intro request and custom need is POSTed here as JSON
# (point it at an n8n/Zapier webhook to collect the dataset).
INSIGHTS_WEBHOOK_URL=

# Supabase. Sessions, messages, searches and leads are written from server
# routes only, so this must be the SECRET key (sb_secret_...), not the
# publishable one. Row Level Security is on and the publishable key gets no
# read access to any table, so it is not used by this app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Daily monitoring email. CRON_SECRET protects /api/report; Vercel sends it
# automatically as a Bearer token when the env var is set. RESEND_API_KEY
# sends the email through resend.com; without it the report is only logged.
# REPORT_EMAIL is the owner address the report goes to.
CRON_SECRET=
RESEND_API_KEY=
REPORT_EMAIL=

# PostHog product analytics on the chat. Public keys, exposed to the browser
# on purpose (that is how PostHog works). Without NEXT_PUBLIC_POSTHOG_KEY the
# app records nothing, so analytics stays dark until you set it in Vercel.
# HOST defaults to https://us.i.posthog.com when unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional spend guards, all with sane defaults: DAILY_CAP_CHAT (500),
# DAILY_CAP_SEARCH (150), DAILY_CAP_INTROS (200) requests per day, and
# SERPAPI_MONTHLY_CAP (250) SerpAPI queries per month before searches
# degrade to demo profiles.

# The live call. Without DAILY_API_KEY the pill always resolves to booking,
# which is the correct degraded behaviour rather than a broken call button.
DAILY_API_KEY=

# Hard ceiling on Daily rooms per calendar month, default 300. Daily's free
# allowance is 10,000 participant minutes and a 15 minute call with two
# people spends about 30, so 300 stays inside it with margin. Past the cap
# the card shows the booking picker instead of ringing.
CALLS_MONTHLY_CAP=

# The ring that reaches a pocket. Without these the operator page is the
# only thing that rings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_PULKIT=
TELEGRAM_CHAT_ID_ROHIT=

# Guards /operator and its routes. Unset denies everyone, so presence stays
# false and every visitor sees booking. Sent as an x-operator-secret header,
# never in a query string.
OPERATOR_SECRET=

# Setups page (/setups). Consultation bookings email this address via
# Resend, sent from an address on the verified domain.
BOOKING_NOTIFY_EMAIL=
BOOKING_FROM_EMAIL=

# Google sign in. Create an OAuth client of type "Web application" at
# console.cloud.google.com, and register the callback EXACTLY as
# https://midsesh.com/api/auth/callback (plus http://localhost:3000/api/auth/callback
# for local work). Google string matches it, so a preview deploy on a
# generated hostname cannot complete a sign in unless you either register that
# URL too or set AUTH_ORIGIN below.
#
# Without both of these the Sign in control is not rendered at all, and every
# auth route answers 503 instead of half working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Any long random string, for example
# `openssl rand -hex 32`. Deliberately separate from the OAuth secret so
# rotating one does not invalidate the other. Changing it signs everybody out,
# which is the intended way to do that.
SESSION_SECRET=

# Optional. Pins the OAuth callback to one origin no matter which deployment
# serves the request, so previews can sign in through the registered
# production URL. Leave unset to use the origin of the request.
AUTH_ORIGIN=
